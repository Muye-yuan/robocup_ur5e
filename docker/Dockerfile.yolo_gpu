# ============================================================================
# GPU Inference Container (Python 3.10 + PyTorch nightly CUDA 12.8)
# ============================================================================
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3-pip \
    git \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip setuptools wheel

# PyTorch nightly with CUDA 12.8 (for RTX 50 series / sm_120)
RUN python3.10 -m pip install --pre torch torchvision \
    --index-url https://download.pytorch.org/whl/nightly/cu128

# Runtime deps
RUN python3.10 -m pip install \
    ultralytics \
    opencv-python \
    numpy \
    roslibpy

WORKDIR /workspace

ENTRYPOINT ["/bin/bash"]
